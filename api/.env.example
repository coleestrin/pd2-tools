# Node Environment
NODE_ENV=production
PORT=3000
API_VERSION=v1

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pd2_tools
POSTGRES_USER=pd2_user
POSTGRES_PASSWORD=password

# Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Season Configuration (for default)
CURRENT_SEASON=13

# CORS (comma-separated origins are supported)
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
